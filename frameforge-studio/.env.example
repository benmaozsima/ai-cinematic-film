# Existing environment variables still work. For local use, prefer adding keys
# through Models & settings; they are saved in the macOS Keychain instead.
# Never use a NEXT_PUBLIC key.
FAL_KEY=
# Optional overrides
# FRAMEFORGE_DATA_DIR=/absolute/path/to/studio-data
# API_PORT=3211
# UI_PORT=3210
#
# Remote deployment contract (configure these in the host's secret manager):
# FRAMEFORGE_DEPLOYMENT_MODE=remote
# FRAMEFORGE_TRUSTED_ORIGINS=https://studio.example.com
# FRAMEFORGE_CREDENTIALS=FAL_KEY,OPENAI_API_KEY,RUNWAY_API_KEY
